@page
@model DeployFront.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-3">Service Health Dashboard</h2>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by hostname..." />
        @if (Model.OutagesOnly)
        {
            <input type="hidden" name="OutagesOnly" value="true" />
        }
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

@if (Model.OutagesOnly)
{
    <div class="alert alert-warning py-2 d-flex justify-content-between align-items-center">
        <span>Showing only services with current outages.</span>
        <a asp-page="/Dashboard/Index" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-sm btn-outline-dark">Clear filter</a>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ServiceTypeFilter))
{
    <div class="alert alert-info py-2 d-flex justify-content-between align-items-center">
        <span>Showing only @Model.ServiceTypeFilter services.</span>
        <a asp-page="/Dashboard/Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-OutagesOnly="@Model.OutagesOnly" class="btn btn-sm btn-outline-dark">Clear service filter</a>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-page="/Dashboard/Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-OutagesOnly="true" class="text-decoration-none d-block">
        <div class="card text-bg-danger h-100" style="cursor:pointer;">
            <div class="card-body">
                <h6 class="card-title">Current Outages</h6>
                <h3 class="mb-0">@Model.CurrentOutages</h3>
            </div>
        </div>
        </a>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <h6 class="card-title">Tracked Services</h6>
                <h3 class="mb-0">@Model.TrackedServiceCount</h3>
            </div>
        </div>
    </div>
@*     <div class="col-md-3">
        <div class="card text-bg-warning h-100">
            <div class="card-body">
                <h6 class="card-title">Unhealthy Checks (1h)</h6>
                <h3 class="mb-0">@Model.UnhealthyChecksLastHour</h3>
            </div>
        </div>
    </div> *@

    <div class="col-md-3">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <h6 class="card-title">Avg Response (1h)</h6>
                <h3 class="mb-0">@Math.Round(Model.AverageResponseMsLastHour, 0) ms</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <a asp-page="/Dashboard/Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-OutagesOnly="@Model.OutagesOnly" asp-route-ServiceTypeFilter="icontrol" class="text-decoration-none text-reset d-block">
            <div class="card h-100 border-secondary" style="cursor:pointer;">
                <div class="card-body">
                    <h6 class="card-title mb-1">iControl</h6>
                    <h4 class="mb-0">@Model.IcontrolServiceCount</h4>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-page="/Dashboard/Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-OutagesOnly="@Model.OutagesOnly" asp-route-ServiceTypeFilter="iris" class="text-decoration-none text-reset d-block">
        <div class="card h-100 border-primary" style="cursor:pointer;">
            <div class="card-body">
                <h6 class="card-title mb-1">Iris</h6>
                <h4 class="mb-0">@Model.IrisServiceCount</h4>
            </div>
        </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-page="/Dashboard/Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-OutagesOnly="@Model.OutagesOnly" asp-route-ServiceTypeFilter="ireport" class="text-decoration-none text-reset d-block">
        <div class="card h-100 border-info" style="cursor:pointer;">
            <div class="card-body">
                <h6 class="card-title mb-1">IReport</h6>
                <h4 class="mb-0">@Model.IreportServiceCount</h4>
            </div>
        </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-page="/Dashboard/Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-OutagesOnly="@Model.OutagesOnly" asp-route-ServiceTypeFilter="sesame" class="text-decoration-none text-reset d-block">
        <div class="card h-100 border-warning" style="cursor:pointer;">
            <div class="card-body">
                <h6 class="card-title mb-1">Sesame</h6>
                <h4 class="mb-0">@Model.SesameServiceCount</h4>
            </div>
        </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-page="/Dashboard/Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-OutagesOnly="@Model.OutagesOnly" asp-route-ServiceTypeFilter="goline" class="text-decoration-none text-reset d-block">
        <div class="card h-100 border-success" style="cursor:pointer;">
            <div class="card-body">
                <h6 class="card-title mb-1">Goline</h6>
                <h4 class="mb-0">@Model.GolineServiceCount</h4>
            </div>
        </div>
        </a>
    </div>
   
</div>

<div class="card">
    <div class="card-header">
        Service Health (Last 7d)
    </div>
    <div class="card-body">
        @if (Model.ServiceUptimeCards.Count == 0)
        {
            <p class="text-muted mb-0">No uptime data available yet.</p>
        }
        else
        {
            <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-lg-5">
                @foreach (var service in Model.ServiceUptimeCards)
                {
                    var barClass = service.UptimePercent >= 99 ? "bg-success" : service.UptimePercent >= 95 ? "bg-warning" : "bg-danger";
                    <div class="col">
                        <a href="@service.ServiceUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-reset d-block h-100">
                        <div class="border rounded p-3 h-100">
                            <div class="fw-semibold text-truncate" title="@service.Hostname">
                                @if (service.ExcludeFromStats)
                                {
                                    <i class="bi bi-bar-chart-line-fill text-secondary me-1"
                                       title="Excluded from stats"
                                       aria-label="Excluded from stats"></i>
                                }
                                else
                                {
                                    <i class="bi bi-bar-chart-line-fill text-success me-1"
                                       title="Included in stats"
                                       aria-label="Included in stats"></i>
                                }
                                @service.Hostname
                            </div>
                            <div class="small text-muted">Type: @(string.IsNullOrWhiteSpace(service.ServiceType) ? "N/A" : service.ServiceType)</div>
                            <div class="small text-muted">Version: @(string.IsNullOrWhiteSpace(service.AppVersion) ? "N/A" : service.AppVersion)</div>
                            <div class="small text-muted">Avg response (7d): @service.AvgResponseMsLast7Days ms</div>
                            <div class="small text-muted mb-2">Uptime (7d): @service.UptimePercent%</div>
                            <div class="progress" role="progressbar" aria-valuenow="@service.UptimePercent" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar @barClass" style="width: @service.UptimePercent%">@service.UptimePercent%</div>
                            </div>
                        </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>
