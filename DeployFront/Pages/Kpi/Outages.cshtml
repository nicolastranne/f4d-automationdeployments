@page
@model DeployFront.Pages.Kpi.OutagesModel
@{
    ViewData["Title"] = "KPI Outages";
}

<h2 class="mb-3">Outages - @Model.Region - @Model.PeriodLabel</h2>

<div class="alert alert-secondary" role="alert">
    <div><strong>Region KPI calculation (@Model.PeriodLabel):</strong></div>
    <div class="small">Services in region: @Model.RegionServiceCount</div>
    <div class="small">Total checks: @Model.TotalChecksInPeriod | Healthy checks: @Model.HealthyChecksInPeriod | Raw unhealthy checks: @Model.RawUnhealthyChecksInPeriod</div>
    <div class="small">Excluded outage seconds: @Model.ExcludedOutageSecondsInPeriod | Carry-over outage seconds (started before month): @Model.CarryoverOutageSecondsInPeriod</div>
    <div class="small">Estimated adjusted checks (@("seconds/180")): @Model.EstimatedExcludedChecksInPeriod</div>
    <div class="small">Adjusted unhealthy checks: @Model.AdjustedUnhealthyChecksInPeriod</div>
    <div class="small">Adjusted uptime (aggregate checks): @Model.AdjustedUptimePercentInPeriod.ToString("0.##")%</div>
    <div class="small">KPI page value (avg per-service adjusted uptime): @Model.KpiRegionAverageUptimePercentInPeriod.ToString("0.##")%</div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SaveMessage))
{
    <div class="alert alert-info">@Model.SaveMessage</div>
}
<div id="kpiSaveNotification" class="alert d-none" role="alert"></div>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">No outages found for this period and region.</div>
}
else
{

    <table class="table table-bordered table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>
                    <a asp-route-year="@Model.Year"
                       asp-route-month="@Model.Month"
                       asp-route-region="@Model.Region"
                       asp-route-sort="@(Model.CurrentSort == "hostname_desc" ? "hostname_asc" : "hostname_desc")">
                        Hostname
                    </a><i class="bi bi-arrow-down-up"></i>
                </th>
                <th>Service Type</th>
                
                <th>
                    <a asp-route-year="@Model.Year"
                           asp-route-month="@Model.Month"
                           asp-route-region="@Model.Region"
                     asp-route-sort="@(Model.CurrentSort == "start_desc" ? "start_asc" : "start_desc")">
                        Start Time UTC
                    </a><i class="bi bi-arrow-down-up"></i>
                </th>


                <th>End UTC</th>
                <th>Duration (s)</th>
                @* <th>Failure Count</th> *@
                
                <th>
                    <a asp-route-year="@Model.Year"
                           asp-route-month="@Model.Month"
                           asp-route-region="@Model.Region"
                           asp-route-sort="@(Model.CurrentSort == "failure_desc" ? "failure_asc" : "failure_desc")">
                        Failure Count
                    </a><i class="bi bi-arrow-down-up"></i>
                </th>



                <th>Status</th>
                <th>Reason</th>
                @if (Model.CanWrite)
                {
                    <th>Exclude</th>
                }
                
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.Hostname</td>
                    <td>@row.ServiceType</td>
                    <td>@row.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@(row.EndTime.HasValue ? row.EndTime.Value.ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                    <td>@(row.DurationSeconds?.ToString() ?? "-")</td>
                    <td>@row.FailureCount</td>
                    <td>@(row.IsOngoing ? "Ongoing" : "Resolved")</td>
                    <td>
                        @if (Model.CanWrite)
                        {
                            <form method="post" asp-page-handler="UpdateReason" class="d-flex gap-2 align-items-center js-update-reason">
                                <input type="hidden" name="outageId" value="@row.OutageId" />
                                <input type="hidden" name="year" value="@Request.Query["year"]" />
                                <input type="hidden" name="month" value="@Request.Query["month"]" />
                                <input type="hidden" name="region" value="@Model.Region" />
                                <input type="text" name="reason" value="@row.Reason" class="form-control form-control-sm js-reason-input" maxlength="1000" />
                                
                                <button type="submit" class="btn btn-sm btn-primary" title="Save">
                                    <i class="bi bi-save"></i>
                                </button>

                            </form>
                        }
                        else
                        {
                            @row.Reason
                        }
                    </td>
                    @if (Model.CanWrite)
                    {
                        <td>
                            <form method="post" asp-page-handler="ToggleExclude" class="d-flex align-items-center gap-2 js-toggle-exclude">
                                <input type="hidden" name="outageId" value="@row.OutageId" />
                                <input type="hidden" name="year" value="@Request.Query["year"]" />
                                <input type="hidden" name="month" value="@Request.Query["month"]" />
                                <input type="hidden" name="region" value="@Model.Region" />
                                <input type="hidden" name="excluded" value="@(row.Excluded ? "false" : "true")" />
                                
                                <span title="@(row.Excluded ? "Excluded" : "Included")">
                                    <i class="bi @(row.Excluded ? "bi-x-circle-fill text-secondary" : "bi-check-circle-fill text-success")"></i>
                                </span>

                                <button type="submit" class="btn btn-sm btn-outline-secondary js-toggle-exclude-btn" @(!row.Excluded && string.IsNullOrWhiteSpace(row.Reason) ? "disabled" : null)>@(row.Excluded ? "Include" : "Exclude")</button>
                            </form>
                        </td>
                    }
                 
                </tr>
            }
            <tr class="table-light fw-semibold">
                <td colspan="5" class="text-end">Total Failure Count</td>
                <td>@Model.TotalFailureCount</td>
                <td colspan="@(Model.CanWrite ? 3 : 2)"></td>
            </tr>
        </tbody>
    </table>

}

<a asp-page="/Kpi/Index" class="btn btn-outline-secondary">Back to KPI</a>

@section Scripts {
<script>
function showKpiSaveNotification(message, type) {
    const notification = document.getElementById('kpiSaveNotification');
    if (!notification) return;

    notification.textContent = message;
    notification.className = 'alert alert-' + (type || 'info');

    setTimeout(function () {
        notification.classList.add('d-none');
    }, 3000);
}

document.addEventListener('submit', async function (e) {
    const form = e.target;
    if (!form.matches('.js-update-reason, .js-toggle-exclude')) return;

    e.preventDefault();

    if (form.matches('.js-toggle-exclude')) {
        const hiddenExcluded = form.querySelector('input[name="excluded"]');
        const isExcludeAction = hiddenExcluded?.value === 'true';
        if (isExcludeAction) {
            const row = form.closest('tr');
            const reasonInput = row?.querySelector('.js-reason-input');
            const reasonText = (reasonInput?.value || '').trim();
            if (!reasonText) {
                showKpiSaveNotification('Please add a reason before excluding this outage.', 'warning');
                return;
            }
        }
    }

    try {
        const response = await fetch(form.action, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new FormData(form)
        });

        const data = await response.json();
        if (!response.ok || !data.success) {
            showKpiSaveNotification(data.error || 'Save failed.', 'danger');
            return;
        }

        showKpiSaveNotification(data.message || 'Saved successfully.', 'success');

        if (form.matches('.js-toggle-exclude')) {
            const hiddenExcluded = form.querySelector('input[name="excluded"]');
            const statusIcon = form.querySelector('i.bi');
            const actionButton = form.querySelector('button[type="submit"]');
            const currentlyExcluded = !!data.excluded;
            const row = form.closest('tr');
            const reasonInput = row?.querySelector('.js-reason-input');
            const reasonText = (reasonInput?.value || '').trim();

            if (hiddenExcluded) {
                hiddenExcluded.value = currentlyExcluded ? 'false' : 'true';
            }

            if (statusIcon) {
                statusIcon.className = 'bi ' + (currentlyExcluded ? 'bi-x-circle-fill text-secondary' : 'bi-check-circle-fill text-success');
                statusIcon.parentElement?.setAttribute('title', currentlyExcluded ? 'Excluded' : 'Included');
            }

            if (actionButton) {
                actionButton.textContent = currentlyExcluded ? 'Include' : 'Exclude';
                actionButton.disabled = !currentlyExcluded && !reasonText;
            }
        }
    } catch {
        showKpiSaveNotification('Save failed.', 'danger');
    }
});

document.addEventListener('input', function (e) {
    const input = e.target;
    if (!input.matches('.js-reason-input')) return;

    const row = input.closest('tr');
    const toggleForm = row?.querySelector('.js-toggle-exclude');
    const hiddenExcluded = toggleForm?.querySelector('input[name="excluded"]');
    const actionButton = toggleForm?.querySelector('.js-toggle-exclude-btn');
    const isExcludeAction = hiddenExcluded?.value === 'true';
    if (actionButton && isExcludeAction) {
        actionButton.disabled = !input.value.trim();
    }
});
</script>
}
