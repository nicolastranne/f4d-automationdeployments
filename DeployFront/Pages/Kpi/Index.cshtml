@page
@model DeployFront.Pages.Kpi.IndexModel
@{
    ViewData["Title"] = "KPI";
}

<h2 class="mb-3">Monthly Uptime KPI by Region</h2>
<p class="text-muted">Average uptime across all services per region (AU, US, EU), grouped by month.</p>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">No KPI data available.</div>
}
else
{
    <table class="table table-bordered table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>Period</th>
                <th>AU</th>
                <th>US</th>
                <th>EU</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.MonthLabel</td>
                    <td>
                        @if (row.AU.HasValue)
                        {
                            <a asp-page="/Kpi/Outages" asp-route-year="@row.Year" asp-route-month="@row.Month" asp-route-region="AU">@($"{Math.Round(row.AU.Value, 2)}%")</a>
                        }
                        else
                        {
                            @("-")
                        }
                    </td>
                    <td>
                        @if (row.US.HasValue)
                        {
                            <a asp-page="/Kpi/Outages" asp-route-year="@row.Year" asp-route-month="@row.Month" asp-route-region="US">@($"{Math.Round(row.US.Value, 2)}%")</a>
                        }
                        else
                        {
                            @("-")
                        }
                    </td>
                    <td>
                        @if (row.EU.HasValue)
                        {
                            <a asp-page="/Kpi/Outages" asp-route-year="@row.Year" asp-route-month="@row.Month" asp-route-region="EU">@($"{Math.Round(row.EU.Value, 2)}%")</a>
                        }
                        else
                        {
                            @("-")
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
