@page "{id:int}"
@model DeployFront.Pages.ServiceMap.DeleteModel
@{
    ViewData["Title"] = "Delete Service Map";
}

<h2>Delete Service Map</h2>
<div class="alert alert-danger">Are you sure you want to delete this record?</div>
<dl class="row">
    <dt class="col-sm-2">Hostname</dt>
    <dd class="col-sm-10">@Model.ServiceMap.hostname</dd>
    <dt class="col-sm-2">IP Address</dt>
    <dd class="col-sm-10">@Model.ServiceMap.ipaddr</dd>
    <dt class="col-sm-2">Port</dt>
    <dd class="col-sm-10">@Model.ServiceMap.port</dd>
    <dt class="col-sm-2">App Name</dt>
    <dd class="col-sm-10">@Model.ServiceMap.appname</dd>
    <dt class="col-sm-2">App Version</dt>
    <dd class="col-sm-10">@Model.ServiceMap.appversion</dd>
    <dt class="col-sm-2">Environment</dt>
    <dd class="col-sm-10">@Model.ServiceMap.environment</dd>
    <dt class="col-sm-2">Service Type</dt>
    <dd class="col-sm-10">@Model.ServiceMap.servicetype</dd>
</dl>
<form method="post">
    <input type="hidden" asp-for="ServiceMap.id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
