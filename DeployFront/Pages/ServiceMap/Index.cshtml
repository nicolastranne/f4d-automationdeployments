@page
@model DeployFront.Pages.ServiceMap.IndexModel
@{
    ViewData["Title"] = "Service Map";
}

<h2>Service Map</h2>
@if (!string.IsNullOrWhiteSpace(Model.ForceSyncMessage))
{
    <div class="alert alert-info">@Model.ForceSyncMessage</div>
}
@* @if (Model.CanWrite)
{
    <div class="mb-2">
        <a class="btn btn-outline-secondary btn-sm" href="?handler=AuthDiagnostics" target="_blank" rel="noopener noreferrer">Auth Diagnostics</a>
    </div>
} *@
<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by hostname, app name, or environment, VM, region, site, customer..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>
@if (Model.CanWrite)
{
    <form method="post" asp-page-handler="ForceSync" class="mb-2">
        <button type="submit" class="btn btn-primary">Force Sync</button>
    </form>
}
<form id="antiForgeryForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<table class="table table-bordered table-striped table-hover table-sm align-middle" style="font-size:0.85rem;">
    <thead>
        <tr>
            <th>Hostname</th>
            <th>VM Name</th>
            <th>IP Address</th>
            <th class="col-small">Port</th>
            @* <th>App Name</th> *@
            <th>App Version</th>
            <th>Environment</th>
            <th>Service Type</th>
            <th>Instance</th>
            <th class="col-sql">SQL Hostname</th>
            <th>DB Name</th>
            <th class="col-hostname">IRIS Hostname</th>
            <th>Customer</th>
            <th>Site</th>
            <th>Notes</th>
            <th class="col-small">Region</th>
            @if (Model.CanWrite)
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
    @{
        var regionIndex = 0;
    }
    @foreach (var regionGroup in Model.ServiceMapsWithVm
        .GroupBy(x => string.IsNullOrWhiteSpace(x.Region) ? "Unknown" : x.Region)
        .OrderBy(g => g.Key))
    {
        var regionId = $"region-{regionIndex++}";
        var customerIndex = 0;

        <tr class="table-secondary">
            <td colspan="16">
                <button class="btn btn-link text-decoration-none p-0" type="button" data-bs-toggle="collapse" data-bs-target=".@regionId" aria-expanded="false">
                    <i class="bi bi-chevron-right me-1"></i><strong>Region: @regionGroup.Key</strong> <span class="text-muted">(@regionGroup.Count())</span>
                </button>
            </td>
        </tr>

        @foreach (var customerGroup in regionGroup
            .GroupBy(x => string.IsNullOrWhiteSpace(x.ServiceMap.customer) ? "Unknown" : x.ServiceMap.customer)
            .OrderBy(g => g.Key))
        {
            var customerId = $"{regionId}-customer-{customerIndex++}";

            <tr class="collapse @regionId table-light">
                <td colspan="16">
                    <button class="btn btn-link text-decoration-none p-0 ms-3" type="button" data-bs-toggle="collapse" data-bs-target=".@customerId" aria-expanded="false">
                        <i class="bi bi-chevron-right me-1"></i><strong>Customer: @customerGroup.Key</strong> <span class="text-muted">(@customerGroup.Count())</span>
                    </button>
                </td>
            </tr>

            @foreach (var row in customerGroup)
            {
                <tr class="collapse @regionId @customerId @(!row.ServiceMap.active ? "service-map-row-inactive" : "")">
                    <td>
                        @{
                            var hostUrl = $"{row.ServiceMap.protocol}://{row.ServiceMap.hostname}";
                            if (row.ServiceMap.port > 0 && row.ServiceMap.port != 80 && row.ServiceMap.port != 443)
                            {
                                hostUrl = $"{hostUrl}";
                            }
                        }

                        <a href="@hostUrl" target="_blank" rel="noopener noreferrer">@row.ServiceMap.hostname</a>
                    </td>
                    <td>@row.VMName</td>
                    <td>@row.ServiceMap.ipaddr</td>
                    <td>@row.ServiceMap.port</td>
                    @* <td>@row.ServiceMap.appname</td> *@
                    <td>@row.ServiceMap.appversion</td>
                    <td>@row.ServiceMap.environment</td>

                    <td>@row.ServiceMap.servicetype</td>
                    <td>@row.ServiceMap.instance</td>
                    <td>@row.ServiceMap.sqlhostname</td>
                    <td>@row.ServiceMap.dbname</td>
                    <td class="col-hostname">@row.ServiceMap.irishostname</td>
                    <td>@row.ServiceMap.customer</td>
                    <td>@row.ServiceMap.site</td>
                    <td>@row.ServiceMap.notes</td>
                    <td>@row.Region</td>
            @if (Model.CanWrite)
            {
                <td>
                    <div class="d-flex flex-row gap-1 align-items-center text-center" style="font-size: 0.9rem;">
                        <button type="button" class="btn btn-sm btn-warning edit-btn p-1" title="Edit" data-id="@row.ServiceMap.id" data-customer="@row.ServiceMap.customer" data-site="@row.ServiceMap.site" data-notes="@row.ServiceMap.notes" data-active="@row.ServiceMap.active" data-hostname="@row.ServiceMap.hostname" data-irishostname="@row.ServiceMap.irishostname">
                            <i class="bi bi-pencil"></i>
                        </button>
                        @{
                            var st = row.ServiceMap.servicetype;
                            var currentVersion = row.ServiceMap.appversion;
                            var showUpgrade = false;
                            if (string.Equals(st, "sesame", StringComparison.OrdinalIgnoreCase))
                            {
                                showUpgrade = true;
                            }
                            else if ((string.Equals(st, "iris", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(st, "goline", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(st, "ireport", StringComparison.OrdinalIgnoreCase))
                                    && Model.AvailableVersions.TryGetValue(st ?? string.Empty, out var versionsForType)
                                    && versionsForType != null
                                    && versionsForType.Count > 0)
                            {
                                showUpgrade = string.IsNullOrWhiteSpace(currentVersion)
                                    || versionsForType.Any(v => !string.IsNullOrWhiteSpace(v)
                                        && string.Compare(v, currentVersion, StringComparison.OrdinalIgnoreCase) > 0);
                            }
                        }
                        @if (showUpgrade)
                        {
                            <button type="button" class="btn btn-sm btn-success p-1 upgrade-btn" title="Upgrade"
                                data-id="@row.ServiceMap.id"
                                data-servicetype="@row.ServiceMap.servicetype"
                                data-current-version="@row.ServiceMap.appversion"
                                data-ipaddr="@row.ServiceMap.ipaddr"
                                data-region="@row.Region"
                                data-instance="@row.ServiceMap.instance"
                                data-sqlhostname="@row.ServiceMap.sqlhostname"
                                data-dbname="@row.ServiceMap.dbname">
                                <i class="bi bi-upload"></i>
                            </button>
                        }
                    </div>
                </td>
            }
                </tr>
            }
        }
    }
    </tbody>




<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editModalLabel">Edit mapping detail</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="editForm">
          <input type="hidden" id="edit-id" name="id" />
          <div class="mb-3">
            <label class="form-label">Hostname</label>
            <input type="text" class="form-control" id="edit-hostname" name="hostname" readonly />
          </div>
          <div class="mb-3">
            <label for="edit-customer" class="form-label">Customer</label>
            <input type="text" class="form-control" id="edit-customer" name="customer" />
          </div>
          <div class="mb-3">
            <label for="edit-site" class="form-label">Site</label>
            <input type="text" class="form-control" id="edit-site" name="site" />
          </div>
          <div class="mb-3">
            <label for="edit-irishostname" class="form-label">Iris Hostname</label>
            <input type="text" class="form-control" id="edit-irishostname" name="irishostname" />
          </div>
          <div class="mb-3">
            <label for="edit-notes" class="form-label">Notes</label>
            <textarea class="form-control" id="edit-notes" name="notes"></textarea>
          </div>
                    
                    <div class="form-check mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               id="edit-active"
                               name="active"
                               value="true">
                        <label class="form-check-label" for="edit-active">
                            Active(disable to stop monitoring)
                        </label>
                    </div>

        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveEditBtn">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Upgrade Modal -->
<div class="modal fade" id="upgradeModal" tabindex="-1" aria-labelledby="upgradeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="upgradeModalLabel">Upgrade Service</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
         <input type="hidden" id="upgrade-id" />
         <div class="mb-2">
             <span id="upgrade-servicetype-title" class="fw-bold" style="font-size:1.1rem;"></span>
         </div>
        <div class="mb-2">
            <label class="form-label">Current Version</label>
            <input type="text" id="upgrade-current-version" class="form-control" readonly />
        </div>
        <div>
            <label for="upgrade-version" class="form-label">Target Version</label>
            <select id="upgrade-version" class="form-select"></select>
        </div>
        <div class="mt-2">
            <label for="upgrade-destination-prefix" class="form-label">VM IP Address</label>
            <input type="text" id="upgrade-destination-prefix" class="form-control" />
        </div>
        <div class="mt-2">
            <label for="upgrade-service-name" class="form-label">Instance/ServiceName</label>
            <input type="text" id="upgrade-service-name" class="form-control" />
        </div>
        <div class="mt-2" id="upgrade-sql-server-group">
            <label for="upgrade-sql-server" class="form-label">SQL Server</label>
            <input type="text" id="upgrade-sql-server" class="form-control" />
        </div>
        <div class="mt-2" id="upgrade-database-group">
            <label for="upgrade-database" class="form-label">Database</label>
            <input type="text" id="upgrade-database" class="form-control" />
        </div>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="upgrade-force-download">
            <label class="form-check-label" for="upgrade-force-download">
                Force Download
            </label>
        </div>
      <div class="alert alert-warning mt-3" role="alert" style="font-size:0.95rem;">
        <strong>Warning:</strong> Please carefully review all the above fields before proceeding with the upgrade.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirmUpgradeBtn">Upgrade</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    var editModal = new bootstrap.Modal(document.getElementById('editModal'));
    var upgradeModal = new bootstrap.Modal(document.getElementById('upgradeModal'));
    var editId = document.getElementById('edit-id');
    var editCustomer = document.getElementById('edit-customer');
    var editSite = document.getElementById('edit-site');
    var editIrisHostname = document.getElementById('edit-irishostname');
    var editNotes = document.getElementById('edit-notes');
    var editActive = document.getElementById('edit-active');
    var editHostname = document.getElementById('edit-hostname');
    var saveBtn = document.getElementById('saveEditBtn');
    var upgradeId = document.getElementById('upgrade-id');
    var upgradeServiceTypeTitle = document.getElementById('upgrade-servicetype-title');
    var upgradeCurrentVersion = document.getElementById('upgrade-current-version');
    var upgradeVersion = document.getElementById('upgrade-version');
    var upgradeDestinationPrefix = document.getElementById('upgrade-destination-prefix');
    var upgradeServiceName = document.getElementById('upgrade-service-name');
    var upgradeSqlServer = document.getElementById('upgrade-sql-server');
    var upgradeDatabase = document.getElementById('upgrade-database');
    var upgradeSqlServerGroup = document.getElementById('upgrade-sql-server-group');
    var upgradeDatabaseGroup = document.getElementById('upgrade-database-group');
    var upgradeForceDownload = document.getElementById('upgrade-force-download');
    var confirmUpgradeBtn = document.getElementById('confirmUpgradeBtn');
    var availableVersions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableVersions));
    var availableVersionsLower = Object.fromEntries(
        Object.entries(availableVersions || {}).map(([k, v]) => [(k || '').toLowerCase(), v])
    );
    var defaultSqlServer = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DefaultSqlServer));
    var defaultDatabase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DefaultDatabase));

    document.querySelectorAll('.edit-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            editId.value = btn.getAttribute('data-id');
            editCustomer.value = btn.getAttribute('data-customer') || '';
            editSite.value = btn.getAttribute('data-site') || '';
            editIrisHostname.value = btn.getAttribute('data-irishostname') || '';
            editNotes.value = btn.getAttribute('data-notes') || '';
            var activeAttr = (btn.getAttribute('data-active') || '').toLowerCase();
            editActive.checked = activeAttr === 'true';
            editHostname.value = btn.getAttribute('data-hostname') || '';
            editModal.show();
        });
    });

    document.querySelectorAll('.upgrade-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = btn.getAttribute('data-id');
            var serviceType = btn.getAttribute('data-servicetype') || '';
            var currentVersion = btn.getAttribute('data-current-version') || '';
            var destinationAddressPrefix = btn.getAttribute('data-ipaddr') || '';
            var serviceName = btn.getAttribute('data-instance') || '';
            var sqlHostname = btn.getAttribute('data-sqlhostname') || '';
            var dbName = btn.getAttribute('data-dbname') || '';
            var normalizedServiceType = (serviceType || '').toLowerCase();
            var isNoSqlDbType = normalizedServiceType === 'sesame' || normalizedServiceType === 'goline';

            upgradeId.value = id || '';
            upgradeServiceTypeTitle.textContent = serviceType ? `${serviceType}` : '';
            upgradeCurrentVersion.value = currentVersion;
            upgradeDestinationPrefix.value = destinationAddressPrefix;
            upgradeServiceName.value = serviceName;
            upgradeSqlServer.value = sqlHostname || defaultSqlServer || '';
            upgradeDatabase.value = dbName || defaultDatabase || '';
            upgradeForceDownload.checked = false;

            upgradeSqlServerGroup.classList.toggle('d-none', isNoSqlDbType);
            upgradeDatabaseGroup.classList.toggle('d-none', isNoSqlDbType);

            var versions = availableVersionsLower[(serviceType || '').toLowerCase()] || [];
            var options = versions
                .filter(function(v) { return v && v.localeCompare(currentVersion, undefined, { sensitivity: 'base' }) > 0; })
                .map(function(v) { return '<option value="' + v + '">' + v + '</option>'; })
                .join('');

            upgradeVersion.innerHTML = options || '<option value="">No higher versions available</option>';
            confirmUpgradeBtn.disabled = !options;
            upgradeModal.show();
        });
    });

    saveBtn.addEventListener('click', function() {
        const antiForgeryToken = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';
        fetch('?handler=EditFields', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken
            },
            body: JSON.stringify({
                id: editId.value,
                customer: editCustomer.value,
                site: editSite.value,
                irishostname: editIrisHostname.value,
                notes: editNotes.value,
                active: editActive.checked
            })
        })
        .then(async r => {
            if (!r.ok) {
                const errorText = await r.text();
                throw new Error(errorText || 'Request failed');
            }
            return r.json();
        })
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Failed to update.');
            }
        })
        .catch(() => alert('Failed to update.'));
    });

    confirmUpgradeBtn.addEventListener('click', function() {
        const antiForgeryToken = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';
        const selectedVersion = upgradeVersion.value;
        const serviceType = (upgradeServiceTypeTitle.textContent || '').trim();
        const normalizedServiceType = serviceType.toLowerCase();
        const isNoSqlDbType = normalizedServiceType === 'sesame' || normalizedServiceType === 'goline';
        const destinationAddressPrefix = upgradeDestinationPrefix.value.trim();
        const serviceName = upgradeServiceName.value.trim();
        const sqlServer = upgradeSqlServer.value.trim();
        const database = upgradeDatabase.value.trim();

        if (!selectedVersion || !destinationAddressPrefix || !serviceName || (!isNoSqlDbType && (!sqlServer || !database))) {
            alert('Please fill all required upgrade fields.');
            return;
        }

        fetch('?handler=Upgrade', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken
            },
            body: JSON.stringify({
                id: parseInt(upgradeId.value, 10),
                serviceType: serviceType,
                targetVersion: selectedVersion,
                destinationAddressPrefix: destinationAddressPrefix,
                serviceName: serviceName,
                sqlServer: sqlServer,
                database: database,
                forceDownload: upgradeForceDownload.checked
            })
        })
        .then(async r => {
            if (!r.ok) {
                const errorText = await r.text();
                throw new Error(errorText || 'Request failed');
            }
            return r.json();
        })
        .then(data => {
            if (data.success) {
                upgradeModal.hide();
                alert('Upgrade triggered successfully.');
            } else {
                alert(data.error || 'Failed to submit upgrade request.');
            }
        })
        .catch(() => alert('Failed to submit upgrade request.'));
    });
});
</script>

}
