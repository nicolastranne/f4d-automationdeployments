@page "/ProvisionInfra"
@model DeployFront.Pages.ProvisionSite.IndexModel
@{
    ViewData["Title"] = "Provision Infra";
}

<h2>Provision Infra</h2>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.RunbookJobId))
{
    <div id="runbook-output" class="card mb-3" data-output-url="@Url.Page("/ProvisionSite/Index", "RunbookOutput")" data-job-id="@Model.RunbookJobId">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center gap-2">
                <div>
                    <h3 class="h5 mb-1">Runbook output</h3>
                    <div class="small text-muted">Job ID: @Model.RunbookJobId</div>
                    <div id="runbook-status" class="small">Status: Submitted</div>
                </div>
                <button id="show-runbook-output" type="button" class="btn btn-outline-primary">View runbook output</button>
            </div>
            <pre id="runbook-output-content" class="mt-3 mb-0 p-3 bg-body-secondary border rounded d-none text-break text-wrap"></pre>
        </div>
    </div>
}

@if (!Model.CanWrite)
{
    <div class="alert alert-warning">You do not have permission to trigger this runbook.</div>
}
else
{
    <form method="post" class="col-md-6" id="provision-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="form-check mb-3">
            <input asp-for="Input.IsNewCustomer" class="form-check-input" />
            <label asp-for="Input.IsNewCustomer" class="form-check-label">Is New customer?</label>
            <span asp-validation-for="Input.IsNewCustomer" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="Input.IsSetupNotification" class="form-check-input" />
            <label asp-for="Input.IsSetupNotification" class="form-check-label">Set up notifications?</label>
            <span asp-validation-for="Input.IsSetupNotification" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="Input.IsSetupFilemanager" class="form-check-input" />
            <label asp-for="Input.IsSetupFilemanager" class="form-check-label">Set up File Manager</label>
            <span asp-validation-for="Input.IsSetupFilemanager" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.RegionPrefix" class="form-label">Deployment Region</label>
            <select asp-for="Input.RegionPrefix" class="form-select">
                <option value="">AU</option>
                <option value="US">US</option>
                <option value="EU">EU</option>
            </select>
            <span asp-validation-for="Input.RegionPrefix" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.CountryCode" class="form-label">Country code</label>
            <input asp-for="Input.CountryCode" class="form-control" placeholder="au" maxlength="2" pattern="[A-Za-z]{2}"  />
            <div class="form-text">Two-letter IBAN country code.</div>
            <span asp-validation-for="Input.CountryCode" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.CustomerName" class="form-label">CustomerName (required)</label>
            <input asp-for="Input.CustomerName" class="form-control" placeholder="Heidelberg" maxlength="100" pattern="[A-Za-z0-9 .-]+" autocomplete="organization" />
            <span asp-validation-for="Input.CustomerName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.SiteName" class="form-label">SiteName (required)</label>
            <input asp-for="Input.SiteName" class="form-control" placeholder="Lysterfield" maxlength="100" pattern="[A-Za-z0-9 .-]+" />
            <span asp-validation-for="Input.SiteName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Port" class="form-label">Port (required)</label>
            <input asp-for="Input.Port" class="form-control" type="number" placeholder="20000" min="1" max="20999" step="1" inputmode="numeric" />
            <span asp-validation-for="Input.Port" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.SourceAddressPrefix" class="form-label">Subnet (required)</label>
            <input asp-for="Input.SourceAddressPrefix" class="form-control" placeholder="10.128.137.0/24" inputmode="decimal" />
            <span asp-validation-for="Input.SourceAddressPrefix" class="text-danger"></span>
        </div>
        @* <div class="mb-3"> 
            <label asp-for="Input.MeshSubnet" class="form-label">MeshSubnet (optional)</label>
            <input asp-for="Input.MeshSubnet" class="form-control" placeholder="10.128.138.0/24" />
        </div>*@

        <div class="mb-3">
            <label asp-for="Input.DestinationAddressPrefix" class="form-label">Target VM ip addr (required)</label>
            <input asp-for="Input.DestinationAddressPrefix" class="form-control" placeholder="10.254.1.9" inputmode="decimal" />
            <div class="form-text">IPv4 address of the target VM.</div>
            <span asp-validation-for="Input.DestinationAddressPrefix" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.ParentZoneName" class="form-label">ParentZoneName or Domain (required)</label>
            <input asp-for="Input.ParentZoneName" class="form-control" placeholder="fleet4d.net" />
            <span asp-validation-for="Input.ParentZoneName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.SiteCode" class="form-label">SiteCode (required)</label>
            <input asp-for="Input.SiteCode" class="form-control" placeholder="empr" minlength="4" maxlength="5" pattern="[A-Za-z0-9-]+" />
            <span asp-validation-for="Input.SiteCode" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.IrisTemplateDBName" class="form-label">IrisTemplateDBName (optional)</label>
            <input asp-for="Input.IrisTemplateDBName" class="form-control" placeholder="Z-iris-masterdb-26-1-202604101" />
        </div>
        @*<div class="mb-3">
            <label asp-for="Input.SesameTemplateDBName" class="form-label">SesameTemplateDBName (optional)</label>
            <input asp-for="Input.SesameTemplateDBName" class="form-control" placeholder="Leave blank to create empty DB" />
        </div>*@
        @*div class="mb-3">
            <label asp-for="Input.ResourceGroupName" class="form-label">ResourceGroupName (optional)</label>
            <input asp-for="Input.ResourceGroupName" class="form-control" placeholder="Q4D-ResourceGroup-1" />
        </div>

        <div class="mb-3">
            <label asp-for="Input.Subscription" class="form-label">Subscription (optional)</label>
            <input asp-for="Input.Subscription" class="form-control" placeholder="Fleet4D" />
        </div>
        <div class="mb-3">
            <label asp-for="Input.KeyVaultName" class="form-label">KeyVaultName (optional)</label>
            <input asp-for="Input.KeyVaultName" class="form-control" placeholder="eau1-f4d-prod-kv-sql01" />
        </div>*@


        <div class="mt-3">
            <button type="submit" class="btn btn-primary" >Deploy Infra</button>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const container = document.getElementById("runbook-output");
            if (!container) {
                return;
            }

            const button = document.getElementById("show-runbook-output");
            const status = document.getElementById("runbook-status");
            const output = document.getElementById("runbook-output-content");
            const jobId = container.dataset.jobId;
            const outputUrl = container.dataset.outputUrl;
            const activeStatuses = new Set(["New", "Activating", "Queued", "Starting", "Running", "Resuming", "Suspending", "Stopping"]);
            let pollTimer;

            async function loadOutput() {
                button.disabled = true;
                try {
                    const response = await fetch(`${outputUrl}&jobId=${encodeURIComponent(jobId)}`, {
                        credentials: "same-origin"
                    });

                    if (!response.ok) {
                        throw new Error("Unable to retrieve runbook output.");
                    }

                    const result = await response.json();
                    status.textContent = `Status: ${result.status ?? "Unknown"}`;
                    output.textContent = result.output ?? "No output is available yet.";
                    output.classList.remove("d-none");

                    window.clearTimeout(pollTimer);
                    if (activeStatuses.has(result.status)) {
                        pollTimer = window.setTimeout(loadOutput, 5000);
                    }
                } catch (error) {
                    status.textContent = error.message;
                    output.classList.remove("d-none");
                } finally {
                    button.disabled = false;
                }
            }

            button.addEventListener("click", loadOutput);
        })();
    </script>
}
